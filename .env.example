# Copy to .env.local for local development, and set the same three values in
# the Vercel dashboard under Settings -> Environment Variables.

# Supabase -> Project Settings -> Data API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Supabase -> Project Settings -> API Keys -> service_role
# SECRET. Server-side only. Never put this in any src/ file.
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string. Signs the login cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
